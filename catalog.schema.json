{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "jvm-switcher JDK catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "releases"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["distribution", "feature", "version", "os", "arch", "url", "sha256"],
        "properties": {
          "distribution": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._+-]+$"
          },
          "feature": {
            "type": "integer",
            "minimum": 1
          },
          "version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._+-]+$"
          },
          "os": {
            "enum": ["windows", "linux", "darwin"]
          },
          "arch": {
            "enum": ["386", "amd64", "arm", "arm64", "ppc64", "ppc64le", "riscv64", "s390x"]
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "file_name": {
            "type": "string",
            "pattern": "^[^/\\\\]+\\.(zip|tar\\.gz|tgz)$"
          }
        }
      }
    }
  }
}